# Main Portal environment placeholders
# Copy to .env (never commit real .env files)

# Backend
SERVER_PORT=8080
PORTAL_APP_NAME=main-portal
PORTAL_API_VERSION=0.1.0
PORTAL_CORS_ORIGINS=http://localhost:5173

# Frontend (optional absolute API base; leave empty to use Vite proxy)
VITE_API_BASE_URL=

# Reserved for later phases — placeholders only
# DATABASE_URL=jdbc:postgresql://localhost:5432/main_portal
# DATABASE_USERNAME=portal
# DATABASE_PASSWORD=change-me
# JWT_SECRET=replace-with-long-random-secret
# SMTP_HOST=smtp.example.com
