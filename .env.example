# Enterprise Portal — local development placeholders
# Copy to `.env` and replace values. Never commit real secrets.

# Application
PORTAL_ENV=local
PORTAL_PUBLIC_BASE_URL=http://localhost:8080
PORTAL_CORS_ALLOWED_ORIGINS=http://localhost:4200

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=portal
POSTGRES_USER=portal_app
POSTGRES_PASSWORD=change-me-app
POSTGRES_MIGRATION_USER=portal_migrate
POSTGRES_MIGRATION_PASSWORD=change-me-migrate

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Session / cookies (dev)
SESSION_COOKIE_NAME=PORTALSESSION
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
CSRF_COOKIE_NAME=XSRF-TOKEN
CSRF_HEADER_NAME=X-XSRF-TOKEN

# MFA encryption (32-byte key, Base64). Generate: openssl rand -base64 32
MFA_ENCRYPTION_KEY_ID=local-v1
MFA_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Mail (Mailpit)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@portal.local

# Bootstrap (one-time first admin). Leave empty after bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=portal-backend
TELEMETRY_ENABLED=true

# Actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when_authorized
